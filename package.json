{
  "name": "syntaxtide",
  "displayName": "OpenTide Query Syntax Highlighting",
  "description": "Adds query language syntax highlighting and language intelligence to OpenTide YAML rule files",
  "version": "0.2.0",
  "publisher": "opentide",
  "icon": "syntaxtide-icon.png",
  "galleryBanner": {
    "color": "#003399",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenTideHQ/SyntaxTide.git"
  },
  "license": "EUPL 1.2",
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "OpenTide",
    "KQL",
    "Kusto",
    "Sentinel",
    "SPL",
    "Splunk",
    "Carbon Black",
    "CBC",
    "SIEM",
    "Detection",
    "Security"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kql",
        "aliases": [
          "Kusto Query Language",
          "KQL"
        ]
      },
      {
        "id": "spl",
        "aliases": [
          "Splunk Processing Language",
          "SPL"
        ]
      },
      {
        "id": "cbc",
        "aliases": [
          "Carbon Black Cloud Query",
          "CBC"
        ]
      }
    ],
    "grammars": [
      {
        "language": "kql",
        "scopeName": "source.kql",
        "path": "./syntaxes/kql.tmLanguage.json"
      },
      {
        "scopeName": "text.opentide.yaml.kql.injection",
        "path": "./syntaxes/kql-injection.json",
        "injectTo": [
          "source.yaml"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.kql": "kql"
        }
      },
      {
        "language": "spl",
        "scopeName": "source.spl",
        "path": "./syntaxes/spl.tmLanguage.json"
      },
      {
        "scopeName": "text.opentide.yaml.spl.injection",
        "path": "./syntaxes/spl-injection.json",
        "injectTo": [
          "source.yaml"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.spl": "spl"
        }
      },
      {
        "language": "cbc",
        "scopeName": "source.cbc",
        "path": "./syntaxes/cbc.tmLanguage.json"
      },
      {
        "scopeName": "text.opentide.yaml.cbc.injection",
        "path": "./syntaxes/cbc-injection.json",
        "injectTo": [
          "source.yaml"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.cbc": "cbc"
        }
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.3",
    "@vscode/vsce": "^2.22.0"
  }
}
